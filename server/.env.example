# Copy this file to .env and change the values.
PORT=3000

# Address of the React dev server (allowed by CORS)
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file (created automatically, relative to server/)
DB_FILE=data/doorlist.db

# Secret used to sign login tokens. Use a long random value in .env.
JWT_SECRET=dev-only-change-me-7f3a9c1e5b
